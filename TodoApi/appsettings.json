{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "SET-IN-appsettings.Local.json-OR-ENV-Jwt__Key",
    "Issuer": "TodoApi",
    "Audience": "TodoClient",
    "ExpiresInMinutes": 360
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ToDoDB": "Server=localhost;Port=3306;Database=ToDoDB;User=CHANGE_ME;Password=CHANGE_ME;"
  }
}
